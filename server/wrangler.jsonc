{
  // Hunter Father — игровой сервер (Cloudflare Workers + Durable Objects)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunter-father",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" }
    ]
  },
  // SQLite-хранилище — доступно на бесплатном тарифе
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Leaderboard"] }
  ],
  "observability": { "enabled": true }
}
